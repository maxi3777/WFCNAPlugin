# --- 引擎生成的临时文件夹 ---
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
ScriptLib/
 
# --- 平台特定的构建输出 ---
# 如果你需要保留特定平台的发布配置，可以根据需要调整
/Build/*
!/Build/NoRedist/
/Binaries/*
 
# --- 项目根目录下的配置文件 ---
# 只有在需要分享本地编辑器偏好时才移除这些
*.vsprops
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
 
# --- Visual Studio & IDE 临时文件 ---
.vs/
.idea/
.vscode/
*.VC.db
*.VC.opendb
 
# --- 编译产生的文件 ---
*.pdb
*.obj
*.exe
*.dll
*.lib
*.exp
*.modules
*.target
*.app
*.ipa
 
# --- 材质编译与追踪文件 ---
*.trace
 
# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db